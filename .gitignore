# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.venv/
**/.venv/
.m2/
**/target/
**/__pycache__/
**/.pytest_cache/
**/.test-tmp/
**/*.pyc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase / GCP service account keys (never commit)
**/firebase-service-account.json
**/credentials/*.json
**/*service-account*.json

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
