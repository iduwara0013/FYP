{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BDEEFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#193642"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show live weather for your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smart Crop to select crop photos for disease screening.",
          "cameraPermission": "Allow Smart Crop to photograph crops for disease screening."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D504D",
          "sounds": [],
          "androidChannels": [
            {
              "channelId": "weather",
              "name": "Weather Alerts",
              "importance": "high",
              "vibration": true
            },
            {
              "channelId": "market",
              "name": "Market Price Alerts",
              "importance": "default",
              "vibration": true
            },
            {
              "channelId": "tips",
              "name": "Daily Tips",
              "importance": "low",
              "vibration": false
            },
            {
              "channelId": "prediction",
              "name": "Prediction Reminders",
              "importance": "default",
              "vibration": true
            },
            {
              "channelId": "news",
              "name": "News Updates",
              "importance": "low",
              "vibration": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true
  }
}
