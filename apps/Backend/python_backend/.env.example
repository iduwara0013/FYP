# ===== Application =====
APP_ENV=development
DEMO_MODE=false
SPRING_BACKEND_URL=http://127.0.0.1:8080
AGENT_TIMEOUT_SECONDS=60
# Optional shared-secret auth for /api/ai/* (leave empty to disable auth)
API_AUTH_TOKEN=

# ===== LLM provider =====
# groq | openai
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# OpenAI alternative (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Neo4j Aura =====
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ===== Firebase (backend service account) =====
# Must match the mobile app's Firebase project (superm-3404a) for Firestore.
FIREBASE_CREDENTIALS_PATH=credentials/firebase-superm-3404a.json

# ===== Weather / market (existing integrations) =====
WEATHER_API_KEY=
MARKET_API_URL=
# Optional alternative live price source (Dambulla/Pettah CSV: crop,price columns)
DAMBULLA_PETTAH_PRICE_URL=
# Set to false to disable the FAOSTAT demand cross-check (default true)
FAOSTAT_ENABLED=true
